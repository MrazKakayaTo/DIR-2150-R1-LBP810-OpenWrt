#!/bin/sh /etc/rc.common

START=60
STOP=20
USE_PROCD=1

start_service() {
    mkdir -p /overlay/lbp810-cups/spool
    mkdir -p /overlay/lbp810-cups/tmp
    mkdir -p /tmp/lbp810-cups/cache
    mkdir -p /var/run/cups

    procd_open_instance
    procd_set_param command /usr/sbin/cupsd -f
    procd_set_param respawn 3600 5 5
    procd_set_param file /etc/cups/cupsd.conf
    procd_close_instance
}
